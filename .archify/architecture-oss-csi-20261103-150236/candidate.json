  "cards": [
    {
      "dot": "cyan",
      "title": "两阶段挂载",
      "items": [
        "kubelet 创建 VolumeAttachment，驱动 Attach / Detach",
        "Controller 在目标节点拉起或删除 FUSE Pod",
        "Node plugin 执行 NodePublish / Unpublish，把挂载点 bind-mount 进 Pod"
      ]
    },
    {
      "dot": "emerald",
      "title": "数据面",
      "items": [
        "应用写 /workspace → 内核 FUSE → ossfs",
        "ossfs 异步上传 OSS，close / flush / fsync 触发",
        "停止时先 unmount flush，再回收 FUSE Pod"
      ]
    },
    {
      "dot": "rose",
      "title": "故障域",
      "items": [
        "Node plugin 异常：新挂载失败，已有 I/O 通常继续",
        "FUSE Pod 异常：/workspace I/O 报错，缓存可能丢失",
        "Controller 异常：已有挂载不受影响，新启动与回收停滞"
      ]
    }
  ]
