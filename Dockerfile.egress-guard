FROM envoyproxy/envoy@sha256:8de97e654644827d62afdbf7e1d3dc9fee01a8690d410dd1c63a30dc6b6cecbb
USER 0
# APT_MIRROR swaps the apt source when archive.ubuntu.com is unreachable
# (e.g. offline/restricted networks). The pinned iptables version is unchanged.
ARG APT_MIRROR=
RUN if [ -n "$APT_MIRROR" ]; then sed -i "s|http://archive.ubuntu.com/ubuntu|$APT_MIRROR|g" /etc/apt/sources.list; fi \
 && apt-get update && apt-get install -y --no-install-recommends iptables=1.8.7-1ubuntu5.2 && rm -rf /var/lib/apt/lists/*
COPY bin/egress-guard-linux-amd64 /usr/local/bin/egress-guard
ENTRYPOINT ["/usr/local/bin/egress-guard"]
