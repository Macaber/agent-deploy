# Build the api-server binary
FROM golang:1.26 AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace
# Copy the Go Modules manifests
COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download

# Copy the Go source
COPY . .

# Build the whole package (main.go + workspace_cache.go). Building only
# main.go drops the workspaceCache implementation and fails to link.
# The build context has no .git, so disable VCS stamping (otherwise some Go
# toolchains fail with "error obtaining VCS status").
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} \
    go build -buildvcs=false -a -o api-server ./cmd/api-server

# Package the binary into a minimal distroless image
FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=builder /workspace/api-server .
USER 65532:65532

EXPOSE 3000
ENTRYPOINT ["/api-server"]
