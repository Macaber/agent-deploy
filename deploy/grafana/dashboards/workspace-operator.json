      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Workspace Operator 看板，支持多集群：顶部「集群」变量可单选/多选/全选；面板按 cluster 标签分组展示。上半区为工作空间规模（总数、当前 Running、同时 Running 峰值及其出现时间，以及 Running 数量随时间变化的折线图），下半区为调谐引擎水位。",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 20,
      "panels": [],
      "title": "工作空间规模",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "控制器当前管理的 Workspace 总数（所有 Phase 之和，**全集群所有命名空间**）。等价于 sum(workspace_active_instances)。注意：门户/API 页面默认只查 bocomwork 一个命名空间，因此这里的数字通常**大于**页面上的「工作空间总数」，属于口径差异。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 3000
              },
              {
                "color": "red",
                "value": 5000
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (cluster) (workspace_total_instances{cluster=~\"$cluster\"})",
          "instant": false,
          "legendFormat": "{{cluster}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "工作空间总数",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "当前 Phase=Running 的工作空间数量（全集群所有命名空间，实时容量水位）。等价于 sum(workspace_active_instances{phase=\"Running\"})。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 4500
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (cluster) (workspace_running_instances{cluster=~\"$cluster\"})",
          "instant": false,
          "legendFormat": "{{cluster}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Running 实例数",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "本 manager 进程启动以来观察到的「同时 Running」峰值（高水位）。与 max_over_time() 不同，它记录每一次相位变化而不是抓取采样点，因此不会漏掉两个采样点之间的短峰。\n\n注意三个反直觉点：\n1) 它只升不降——删掉/缩容工作空间不会让峰值降低，只有 manager 重启才回到当前值；\n2) 进程重启/主备切换后归零并从当前 Running 数重新起算；\n3) 数字可能大于本面板时间范围内的数据量，因为值是 manager 内存里的历史，接入抓取之前就已存在。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "orange",
            "mode": "fixed"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "id": 11,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (cluster) (workspace_running_peak_instances{cluster=~\"$cluster\"})",
          "instant": false,
          "legendFormat": "{{cluster}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Running 峰值（同时运行数）",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "上面那个峰值第一次出现的时刻。Prometheus 的 max_over_time() 只给数值不给时间，因此单独用 workspace_running_peak_timestamp_seconds 记录（该指标是 Unix 秒，Grafana 的 dateTimeAsIso 按毫秒解析，故查询里 ×1000）。\n\n**这个时间可能早于你在 Prometheus 开始抓取的时间**：它是 manager 进程内存里早就记录好的峰值时刻，不是数据采集起点。想确认可以对比 manager Pod 的 startTime。manager 重启后此值会重置为重启后首次达到峰值的时刻。\n\n值为 0 表示本进程尚未出现过 Running 工作空间（映射为「尚无峰值」）。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "none"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "text",
                  "index": 0,
                  "text": "尚无峰值"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "dateTimeAsIso"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "id": 12,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (cluster) (workspace_running_peak_timestamp_seconds{cluster=~\"$cluster\"}) * 1000",
          "instant": true,
          "legendFormat": "{{cluster}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "峰值出现时间",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Running 状态工作空间数量随时间的折线图。绿实线＝当前 Running 数；橙虚线＝本进程观察到的峰值（重启后重新计）；蓝线＝工作空间总数，用于看 Running 在总量中的占比。图例 Max 列即为该时间窗口内的峰值。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "decimals": 0,
          "mappings": [],
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* · 运行中"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 25
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* · 峰值"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    10,
                    10
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* · 总数"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 5
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "id": 13,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max",
            "mean"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (cluster) (workspace_running_instances{cluster=~\"$cluster\"})",
          "instant": false,
          "legendFormat": "{{cluster}} · 运行中",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (cluster) (workspace_running_peak_instances{cluster=~\"$cluster\"})",
          "instant": false,
          "legendFormat": "{{cluster}} · 峰值",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (cluster) (workspace_total_instances{cluster=~\"$cluster\"})",
          "instant": false,
          "legendFormat": "{{cluster}} · 总数",
          "range": true,
          "refId": "C"
        }
      ],
      "title": "Running 工作空间数量随时间变化",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
